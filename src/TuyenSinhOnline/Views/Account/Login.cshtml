@model TuyenSinhOnline.Models.Account.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<section class="shell auth-section">
    <aside class="auth-intro"><span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span><h1>Hành trình của bạn<br /><span>tiếp tục tại đây.</span></h1><p>Đăng nhập để truy cập không gian phù hợp với vai trò của bạn.</p><div class="intro-rule"></div><div class="intro-item"><span class="check-circle" aria-hidden="true">✓</span><div><strong>Một tài khoản riêng</strong><p>Sử dụng email đã đăng ký hoặc tài khoản được cấp.</p></div></div><div class="intro-item"><span class="check-circle" aria-hidden="true">✓</span><div><strong>Đúng quyền truy cập</strong><p>Hệ thống đưa bạn đến khu vực theo vai trò tài khoản.</p></div></div><a class="text-link" asp-controller="Home" asp-action="Index"><span aria-hidden="true">←</span> Về trang chủ</a></aside>
    <div class="auth-panel"><span class="form-kicker">TÀI KHOẢN CỦA BẠN</span><h2>Đăng nhập</h2><p class="form-description">Nhập email và mật khẩu để tiếp tục.</p>
        <form asp-controller="Account" asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
            <div class="form-field"><label asp-for="Email">Địa chỉ email</label><input asp-for="Email" type="email" autocomplete="username" placeholder="ban@example.com" autofocus /><span asp-validation-for="Email" class="field-error"></span></div>
            <div class="form-field"><label asp-for="Password">Mật khẩu</label><div class="password-field"><input asp-for="Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" /><button class="password-toggle" type="button" data-password-target="Password" aria-label="Hiện mật khẩu" aria-pressed="false">Hiện</button></div><span asp-validation-for="Password" class="field-error"></span></div>
            <label class="checkbox-field"><input asp-for="RememberMe" /><span>Ghi nhớ đăng nhập trên thiết bị này</span></label>
            <button class="button button-primary button-full" type="submit">Đăng nhập <span aria-hidden="true">→</span></button>
        </form>
        <p class="auth-switch">Bạn là thí sinh mới? <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Tạo tài khoản</a></p><p class="form-footnote">Cán bộ và quản trị viên sử dụng tài khoản được cấp.</p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
