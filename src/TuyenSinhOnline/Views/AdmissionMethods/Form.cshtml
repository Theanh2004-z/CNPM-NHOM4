@model TuyenSinhOnline.Models.Management.MethodForm
@{ var title = Model.Id == 0 ? "Thêm phương thức" : "Sửa phương thức"; ViewData["Title"] = title; }
<section class="shell management-page"><partial name="_ManagementNav" /><header class="management-heading"><div><span class="eyebrow">PHƯƠNG THỨC XÉT TUYỂN</span><h1>@title</h1><p>Ngừng sử dụng phương thức sẽ giữ các cấu hình đã liên kết.</p></div></header>
<form class="management-form" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? (int?)null : Model.Id)" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="form-grid"><div class="form-field"><label asp-for="Code"></label><input asp-for="Code" maxlength="30" /><span asp-validation-for="Code" class="field-error"></span></div><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" maxlength="200" /><span asp-validation-for="Name" class="field-error"></span></div></div>
<div class="form-field"><label asp-for="RequirementsDescription"></label><textarea asp-for="RequirementsDescription" maxlength="4000" rows="5"></textarea><span asp-validation-for="RequirementsDescription" class="field-error"></span></div><label class="checkbox-field"><input asp-for="IsActive" /><span>Đang sử dụng</span></label><div class="form-actions"><button class="button button-primary" type="submit">Lưu phương thức</button><a asp-action="Index">Quay lại danh sách</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
