@model List<AdmissionMethod>
@{ ViewData["Title"] = "Phương thức xét tuyển"; }
<section class="management-page"><header class="management-heading"><div><span class="eyebrow">DANH MỤC TUYỂN SINH</span><h1>Phương thức xét tuyển</h1><p>Thiết lập phương thức và điều kiện tiếp nhận hồ sơ.</p></div><a class="button button-primary" asp-action="Create">Thêm phương thức</a></header>
<form class="filter-bar" method="get"><label>Tìm mã hoặc tên phương thức<input name="q" value="@ViewData["Query"]" maxlength="200" /></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="active" selected="@(ViewData["Status"] as string == "active")">Đang sử dụng</option><option value="inactive" selected="@(ViewData["Status"] as string == "inactive")">Ngừng sử dụng</option></select></label><button class="button button-outline">Tìm kiếm</button><a asp-action="Index">Bỏ lọc</a></form>
<p class="table-scroll-hint">Vuốt ngang bảng để xem đầy đủ các cột.</p><div class="table-wrap"><table><caption>@Model.Count phương thức trong kết quả</caption><thead><tr><th>Mã</th><th>Phương thức</th><th>Điều kiện</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model) { <tr data-row-id="@item.Id" data-code="@item.Code"><td><strong>@item.Code</strong></td><td>@item.Name</td><td class="description-cell">@item.RequirementsDescription</td><td><span class="badge @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "Đang sử dụng" : "Ngừng sử dụng")</span></td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a><form asp-action="SetActive" asp-route-id="@item.Id" method="post"><input name="isActive" type="hidden" value="@((!item.IsActive).ToString().ToLowerInvariant())" /><button class="link-button" type="submit">@(item.IsActive ? "Ngừng sử dụng" : "Sử dụng lại")</button></form></div></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="5" class="empty-state">Chưa có phương thức phù hợp. Thêm phương thức hoặc bỏ bộ lọc để tiếp tục.</td></tr> }
</tbody></table></div></section>
