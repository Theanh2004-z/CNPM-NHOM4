@model TuyenSinhOnline.Models.Management.RoundForm
@{ var title = Model.Id == 0 ? "Thêm đợt tuyển sinh" : "Sửa đợt tuyển sinh"; ViewData["Title"] = title; }
<section class="shell management-page"><partial name="_ManagementNav" /><header class="management-heading"><div><span class="eyebrow">KẾ HOẠCH TUYỂN SINH</span><h1>@title</h1><p>Sau khi lưu đợt, chọn ngành, chỉ tiêu và phương thức áp dụng tại trang cấu hình.</p></div></header>
<form class="management-form" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? (int?)null : Model.Id)" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="form-grid"><div class="form-field"><label asp-for="Code"></label><input asp-for="Code" maxlength="30" /><span asp-validation-for="Code" class="field-error"></span></div><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" maxlength="200" /><span asp-validation-for="Name" class="field-error"></span></div><div class="form-field"><label asp-for="AdmissionYear"></label><input asp-for="AdmissionYear" type="number" min="2000" max="2100" /><span asp-validation-for="AdmissionYear" class="field-error"></span></div><div></div><div class="form-field"><label asp-for="StartAt"></label><input asp-for="StartAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /><span asp-validation-for="StartAt" class="field-error"></span></div><div class="form-field"><label asp-for="EndAt"></label><input asp-for="EndAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /><span asp-validation-for="EndAt" class="field-error"></span></div></div><p class="management-help">Giờ Việt Nam (UTC+7). Thời điểm đóng phải sau thời điểm mở.</p><label class="checkbox-field"><input asp-for="IsActive" /><span>Đang sử dụng</span></label><div class="form-actions"><button class="button button-primary" type="submit">Lưu đợt tuyển sinh</button><a asp-action="Index">Quay lại danh sách</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
