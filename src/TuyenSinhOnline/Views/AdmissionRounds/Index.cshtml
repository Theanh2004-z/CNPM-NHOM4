@using TuyenSinhOnline.Models.Management
@model List<AdmissionRound>
@{ ViewData["Title"] = "Đợt tuyển sinh"; }
<section class="management-page"><header class="management-heading"><div><span class="eyebrow">KẾ HOẠCH TUYỂN SINH</span><h1>Đợt tuyển sinh</h1><p>Thời gian hiển thị theo giờ Việt Nam (UTC+7).</p></div><a class="button button-primary" asp-action="Create">Thêm đợt</a></header>
<form class="filter-bar" method="get"><label>Tìm mã hoặc tên đợt<input name="q" value="@ViewData["Query"]" maxlength="200" /></label><label>Năm tuyển sinh<input name="year" type="number" min="2000" max="2100" value="@ViewData["Year"]" placeholder="Tất cả" /></label><button class="button button-outline">Tìm kiếm</button><a asp-action="Index">Bỏ lọc</a></form>
<p class="table-scroll-hint">Vuốt ngang bảng để xem đầy đủ các cột.</p><div class="table-wrap"><table><caption>@Model.Count đợt trong kết quả</caption><thead><tr><th>Đợt tuyển sinh</th><th>Năm</th><th>Mở tiếp nhận</th><th>Đóng tiếp nhận</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model) { <tr data-row-id="@item.Id" data-code="@item.Code"><td><strong>@item.Code</strong><br />@item.Name</td><td>@item.AdmissionYear</td><td>@item.StartAt.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@item.EndAt.ToString("dd/MM/yyyy HH:mm:ss")</td><td><span class="badge @(AdmissionClock.Status(item) == "Đang mở" ? "active" : "inactive")">@AdmissionClock.Status(item)</span></td><td><div class="row-actions"><a asp-action="Details" asp-route-id="@item.Id">Cấu hình</a><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a><form asp-action="SetActive" asp-route-id="@item.Id" method="post"><input name="isActive" type="hidden" value="@((!item.IsActive).ToString().ToLowerInvariant())" /><button class="link-button" type="submit">@(item.IsActive ? "Ngừng sử dụng" : "Sử dụng lại")</button></form></div></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="6" class="empty-state">Chưa có đợt phù hợp. Hãy thêm đợt hoặc bỏ bộ lọc.</td></tr> }
</tbody></table></div><p class="management-help">Đợt mở đúng thời điểm bắt đầu và đóng ngay tại thời điểm kết thúc. Đợt ngừng sử dụng không tiếp nhận hồ sơ mới.</p></section>
