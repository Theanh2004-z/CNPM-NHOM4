@model TuyenSinhOnline.Models.Management.MajorForm
@{ var title = Model.Id == 0 ? "Thêm ngành học" : "Sửa ngành học"; ViewData["Title"] = title; }
<section class="shell management-page"><partial name="_ManagementNav" /><header class="management-heading"><div><span class="eyebrow">DANH MỤC NGÀNH</span><h1>@title</h1><p>Mã ngành là duy nhất. Ẩn ngành để ngừng sử dụng mà vẫn giữ lịch sử.</p></div></header>
<form class="management-form" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? (int?)null : Model.Id)" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<div class="form-grid"><div class="form-field"><label asp-for="Code"></label><input asp-for="Code" maxlength="20" /><span asp-validation-for="Code" class="field-error"></span></div><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" maxlength="200" /><span asp-validation-for="Name" class="field-error"></span></div></div>
<div class="form-field"><label asp-for="Description"></label><textarea asp-for="Description" rows="4" maxlength="1000"></textarea><span asp-validation-for="Description" class="field-error"></span></div><label class="checkbox-field"><input asp-for="IsActive" /><span>Đang sử dụng</span></label><div class="form-actions"><button class="button button-primary" type="submit">Lưu ngành học</button><a asp-action="Index">Quay lại danh sách</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
