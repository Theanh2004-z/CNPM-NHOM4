@model List<Major>
@{ ViewData["Title"] = "Quản lý ngành học"; }
<section class="shell management-page">
    <partial name="_ManagementNav" />
    <header class="management-heading"><div><span class="eyebrow">DANH MỤC TUYỂN SINH</span><h1>Ngành học</h1><p>Quản lý thông tin ngành. Ngành đã ẩn vẫn giữ các dữ liệu liên kết.</p></div><a class="button button-primary" asp-action="Create">Thêm ngành</a></header>
    <form class="filter-bar" method="get"><label>Tìm mã hoặc tên ngành<input name="q" value="@ViewData["Query"]" maxlength="200" placeholder="Nhập mã hoặc tên ngành" /></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="active" selected="@(ViewData["Status"] as string == "active")">Đang sử dụng</option><option value="inactive" selected="@(ViewData["Status"] as string == "inactive")">Đã ẩn</option></select></label><button class="button button-outline">Tìm kiếm</button><a asp-action="Index">Bỏ lọc</a></form>
    <p class="table-scroll-hint">Vuốt ngang bảng để xem đầy đủ các cột.</p><div class="table-wrap"><table><caption>@Model.Count ngành trong kết quả</caption><thead><tr><th>Mã ngành</th><th>Tên ngành</th><th>Mô tả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
    @foreach (var item in Model) {
        <tr data-row-id="@item.Id" data-code="@item.Code"><td><strong>@item.Code</strong></td><td>@item.Name</td><td class="description-cell">@item.Description</td><td><span class="badge @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "Đang sử dụng" : "Đã ẩn")</span></td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a><form method="post" asp-action="SetActive" asp-route-id="@item.Id"><input type="hidden" name="isActive" value="@((!item.IsActive).ToString().ToLowerInvariant())" /><button class="link-button" type="submit">@(item.IsActive ? "Ẩn ngành" : "Sử dụng lại")</button></form></div></td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="empty-state">Chưa có ngành phù hợp. Bạn có thể thêm ngành mới hoặc bỏ bộ lọc.</td></tr> }
    </tbody></table></div>
</section>
