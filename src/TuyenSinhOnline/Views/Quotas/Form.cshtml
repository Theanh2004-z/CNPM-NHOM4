@model TuyenSinhOnline.Models.Management.QuotaForm
@{ var title = Model.Id == 0 ? "Thêm cấu hình ngành" : "Sửa cấu hình ngành"; ViewData["Title"] = title; }
<section class="management-page"><header class="management-heading"><div><span class="eyebrow">CHỈ TIÊU VÀ PHƯƠNG THỨC</span><h1>@title</h1><p>Cấu hình chỉ tiêu và phương thức cho một ngành trong một đợt tuyển sinh.</p></div></header>
<form class="management-form" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? (int?)null : Model.Id)" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="form-grid"><div class="form-field"><label asp-for="RoundId"></label><select asp-for="RoundId" asp-items="Model.Rounds" disabled="@(Model.Id != 0)"><option value="">Chọn đợt tuyển sinh</option></select>@if (Model.Id != 0) { <input asp-for="RoundId" type="hidden" /> }<span asp-validation-for="RoundId" class="field-error"></span></div><div class="form-field"><label asp-for="MajorId"></label><select asp-for="MajorId" asp-items="Model.Majors" disabled="@(Model.Id != 0)"><option value="">Chọn ngành học</option></select>@if (Model.Id != 0) { <input asp-for="MajorId" type="hidden" /> }<span asp-validation-for="MajorId" class="field-error"></span></div></div><div class="form-field"><label asp-for="Quota"></label><input asp-for="Quota" type="number" min="0" step="1" /><span asp-validation-for="Quota" class="field-error"></span></div>
<fieldset class="method-options"><legend>Phương thức áp dụng</legend><p>Chọn ít nhất một phương thức nếu cấu hình đang bật.</p>@foreach (var method in Model.Methods) { <label class="method-option"><input type="checkbox" name="SelectedMethodIds" value="@method.Id" checked="@(Model.SelectedMethodIds.Contains(method.Id))" /><span><strong>@method.Code — @method.Name</strong>@if (!method.IsActive) { <small>Đã ngừng sử dụng. Giữ để bảo toàn cấu hình cũ hoặc bỏ chọn để tắt liên kết.</small> }</span></label> }@if (Model.Methods.Count == 0) { <p>Chưa có phương thức đang sử dụng. <a asp-controller="AdmissionMethods" asp-action="Create">Thêm phương thức</a> trước khi bật cấu hình.</p> }<span asp-validation-for="SelectedMethodIds" class="field-error"></span></fieldset>
<label class="checkbox-field"><input asp-for="IsEnabled" /><span>Cho phép sử dụng cấu hình này</span></label><p class="management-help">Tắt cấu hình hoặc bỏ chọn phương thức sẽ giữ dữ liệu đã liên kết. Ngành, đợt và phương thức cũng cần đang sử dụng để có thể tiếp nhận hồ sơ mới.</p><div class="form-actions"><button class="button button-primary" type="submit">Lưu cấu hình</button><a asp-action="Index">Quay lại danh sách</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
