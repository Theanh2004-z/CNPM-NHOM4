@model List<RoundMajor>
<p class="table-scroll-hint">Vuốt ngang bảng để xem đầy đủ các cột.</p><div class="table-wrap"><table><caption>@Model.Count cấu hình ngành theo đợt</caption><thead><tr><th>Đợt tuyển sinh</th><th>Ngành học</th><th>Chỉ tiêu</th><th>Phương thức được chọn</th><th>Sử dụng</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model) { <tr data-row-id="@item.Id"><td>@item.Round?.Code</td><td><strong>@item.Major?.Code</strong><br />@item.Major?.Name @if (item.Major?.IsActive == false) { <span class="badge inactive">Ngành đã ẩn</span> }</td><td>@item.Quota</td><td>@foreach (var link in item.RoundMajorMethods.Where(x => x.IsEnabled).OrderBy(x => x.Method!.Code)) { <span class="method-chip">@link.Method?.Name @(link.Method?.IsActive == false ? "(ngừng sử dụng)" : "")</span> } @if (!item.RoundMajorMethods.Any(x => x.IsEnabled)) { <span>Chưa chọn</span> }</td><td><span class="badge @(item.IsEnabled ? "active" : "inactive")">@(item.IsEnabled ? "Bật" : "Tắt")</span></td><td><a asp-controller="Quotas" asp-action="Edit" asp-route-id="@item.Id">Sửa cấu hình</a></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="6" class="empty-state">Chưa có cấu hình. Thêm ngành, chỉ tiêu và chọn phương thức để bắt đầu.</td></tr> }
</tbody></table></div>
