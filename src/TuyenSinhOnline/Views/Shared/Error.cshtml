@model ErrorViewModel
@{ ViewData["Title"] = "Có lỗi xảy ra"; }
<section class="shell message-section"><div class="message-card"><span class="message-code">KHÔNG THỂ HOÀN TẤT YÊU CẦU</span><h1>Có lỗi xảy ra.<br /><span>Vui lòng thử lại.</span></h1><p>Hệ thống chưa xử lý được yêu cầu của bạn. Hãy quay lại trang chủ và thử lại sau.</p>@if (Model.ShowRequestId) { <p class="request-id">Mã yêu cầu: <code>@Model.RequestId</code></p> }<a class="button button-primary" asp-controller="Home" asp-action="Index">Về trang chủ <span aria-hidden="true">→</span></a></div></section>
