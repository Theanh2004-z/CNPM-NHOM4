@using System.Security.Claims
@{
    Layout = "_Layout";
    var fullName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name;
    var email = User.FindFirstValue(ClaimTypes.Email) ?? User.Identity?.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff-workspaces.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

<div class="admin-page shell">
    <aside class="admin-sidebar" aria-label="Điều hướng quản trị">
        <span class="staff-role-label">QUẢN TRỊ VIÊN</span>
        <h2>Điều hành <br />tuyển sinh.</h2>
        <partial name="_ManagementNav" />
        <div class="admin-sidebar-note">
            <strong>Quyền quản lý cấu hình</strong>
            <p>Thêm, sửa và ngừng sử dụng danh mục, đợt tuyển sinh, chỉ tiêu và phương thức áp dụng.</p>
        </div>
        <div class="staff-user"><strong>@fullName</strong><span>@email</span><small>Quản trị viên</small></div>
    </aside>
    <div class="admin-main">
        @if (TempData["ManagementSuccess"] is string success)
        {
            <div class="notice success" role="status">@success</div>
        }
        @RenderBody()
    </div>
</div>
