@using System.Security.Claims
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var fullName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name ?? "Tài khoản";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var workspaceLabel = User.IsInRole(TuyenSinhOnline.Security.RoleNames.Administrator) ? "Không gian quản trị"
        : User.IsInRole(TuyenSinhOnline.Security.RoleNames.AdmissionsOfficer) ? "Không gian cán bộ" : "Cổng thí sinh";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#142c3a" />
    <meta name="description" content="Cổng tuyển sinh trực tuyến. Đăng ký tài khoản và truy cập không gian làm việc theo vai trò." />
    <title>@ViewData["Title"] | Tuyển sinh trực tuyến</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Đến nội dung chính</a>
    <header class="site-header">
        <nav class="shell navigation" aria-label="Điều hướng chính">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Tuyển sinh trực tuyến — Trang chủ">
                <span class="brand-mark" aria-hidden="true">TS<span></span></span>
                <span>Tuyển sinh<span class="brand-caption">CỔNG TRỰC TUYẾN</span></span>
            </a>
            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" data-nav-toggle>Menu <span aria-hidden="true">☰</span></button>
            <div id="main-navigation" class="nav-content">
                <div class="nav-links">
                    <a class="nav-link @(currentController == "Home" ? "is-active" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    @if (signedIn)
                    {
                        <a class="nav-link @(currentController != "Home" && currentController != "Account" ? "is-active" : "")" asp-controller="Dashboard" asp-action="Index">@workspaceLabel</a>
                        @if (User.IsInRole(TuyenSinhOnline.Security.RoleNames.Administrator))
                        { <a class="nav-link" asp-controller="AdmissionRounds" asp-action="Index">Quản lý tuyển sinh</a> }
                    }
                </div>
                <div class="nav-actions">
                    @if (signedIn)
                    {
                        <span class="nav-user" title="@fullName"><span class="status-dot" aria-hidden="true"></span>@fullName</span>
                        <form asp-controller="Account" asp-action="Logout" method="post"><button class="button button-outline button-small" type="submit">Đăng xuất</button></form>
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        <a class="button button-primary button-small" asp-controller="Account" asp-action="Register">Tạo tài khoản <span aria-hidden="true">↗</span></a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" tabindex="-1">@RenderBody()</main>
    <footer class="site-footer"><div class="shell footer-content"><div><strong>TuyenSinhOnline</strong><span>Đồ án Công nghệ phần mềm · Sprint 1</span></div><a asp-controller="Home" asp-action="Privacy">Thông tin &amp; quyền riêng tư <span aria-hidden="true">↗</span></a></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
