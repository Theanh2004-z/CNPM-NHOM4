@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    (string Controller, string Label)[] items =
    [
        ("Admin", "Tổng quan"),
        ("Majors", "Ngành học"),
        ("AdmissionMethods", "Phương thức"),
        ("AdmissionRounds", "Đợt tuyển sinh"),
        ("Quotas", "Chỉ tiêu & áp dụng")
    ];
}
<nav aria-label="Chức năng quản trị">
    @foreach (var item in items)
    {
        var selected = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase);
        <a asp-controller="@item.Controller" asp-action="Index"
           class="@(selected ? "selected" : null)" aria-current="@(selected ? "page" : null)">
            @item.Label
            @if (selected) { <span aria-hidden="true">↗</span> }
        </a>
    }
</nav>
